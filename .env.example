# ==============================================================================
# AI Customer Support Automation - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file or any API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string.
# On Azure Container Apps, use the Supabase IPv4 Connection Pooler (session mode, port 5432):
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. OpenAI API
# ------------------------------------------------------------------------------
# Your OpenAI API key for customer support triage and answer generation.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 & Gmail API Credentials
# ------------------------------------------------------------------------------
# Obtained from Google Cloud Console (Desktop application credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# Generated by running: uv run python -m scripts.get_refresh_token
GOOGLE_REFRESH_TOKEN=1//0your-refresh-token-here

# ------------------------------------------------------------------------------
# 4. Model Selection (Pydantic AI / OpenAI)
# ------------------------------------------------------------------------------
# Classification model for intent triage and escalation detection:
CLASSIFIER_MODEL=openai:gpt-6-luna

# Agent model for synthesizing knowledge base answers:
AGENT_MODEL=openai:gpt-6.1-sol

# ------------------------------------------------------------------------------
# 5. Poller Worker Configuration
# ------------------------------------------------------------------------------
# Polling interval in seconds when running the continuous poller loop locally:
POLL_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# 6. Admin Dashboard Authentication & Security
# ------------------------------------------------------------------------------
# Basic Auth credentials for the React Admin Dashboard & API:
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-to-a-secure-password

# Allowed CORS origins (comma-separated, or '*' for permissive dev access):
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 7. Production Logging & Telemetry
# ------------------------------------------------------------------------------
# Suppress Pydantic AI startup banner in production container logs (1 = disabled):
PYDANTIC_AI_NO_BANNER=1
